# Local Apache only (not part of the build).
# Serves the built site from dist/ at http://localhost/for-fun/zodiac/ (build it with `npm run build:local`).
# Needs mod_rewrite and `AllowOverride FileInfo` (or All) for this folder, like ../quran/.htaccess.
# Always check with the server for a fresh copy while developing (a 304 answer is cheap).
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /for-fun/zodiac/
  # / -> the built home page
  RewriteRule ^$ dist/index.html [L]
  # a file of the build: assets/, storybook/, sw.js, manifest.webmanifest, favicon.svg ...
  RewriteCond %{DOCUMENT_ROOT}/for-fun/zodiac/dist/$1 -f
  RewriteRule ^(.+)$ dist/$1 [L]
  # /storybook -> /storybook/
  RewriteCond %{DOCUMENT_ROOT}/for-fun/zodiac/dist/$1/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
  # /storybook/ -> dist/storybook/index.html
  RewriteCond %{DOCUMENT_ROOT}/for-fun/zodiac/dist/$1index.html -f
  RewriteRule ^(.+/)$ dist/$1index.html [L]
  # the app's own addresses (/sign/aries ...) are not files: the app opens and routes them itself
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^sign(/.*)?$ dist/index.html [L]
</IfModule>
